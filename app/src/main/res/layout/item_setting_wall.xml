<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 🖼️ PREVIEW WALLPAPER -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:cardCornerRadius="16dp"
        android:backgroundTint="#33FFFFFF">

        <ImageView
            android:id="@+id/img_preview_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/default_walpaper"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- 🎨 PILIHAN WALLPAPER DEFAULT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Wallpaper"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_semibold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <!-- BLACK WALLPAPER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="12dp">

            <ImageView
                android:id="@+id/preview_black_wall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/black_wallpaper"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- WHITE WALLPAPER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="12dp">

            <ImageView
                android:id="@+id/preview_white_wall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/white_wallpaper"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 🔘 BUTTON UPLOAD & RESET -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_upload"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:text="Upload"
            android:background="@drawable/tombol_uploud"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins_semibold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Reset"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/kaca"
            android:fontFamily="@font/poppins_semibold"/>
    </LinearLayout>

    <!-- 💡 TIPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/glass_card"
        android:padding="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Gambar dari Galeri gunakan gambar dengan resolusi tinggi untuk hasil terbaik."
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"/>
    </LinearLayout>

    <!-- ✅ BUTTON SELESAI -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_selesai_wall"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Selesai"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3B82F6"
        android:fontFamily="@font/poppins_semibold"/>

</LinearLayout>